# Compose production runtime settings.
APP_PORT="3000"
DATABASE_ENV="production"
MONGODB_REPLICA_SET_NAME="rs0"
MONGODB_DATABASE="academic_portfolio"
MONGODB_ROOT_USER="root"
MONGODB_ROOT_PASSWORD=""
MONGODB_USERNAME="portfolio_app"
MONGODB_PASSWORD=""
# Long random internal replica-set authentication key.
MONGODB_REPLICA_SET_KEY=""

# DATABASE_URL is assembled by docker-compose.yml from the MongoDB values above.
# Keep this value for host-side Prisma commands only; never commit real credentials.
DATABASE_URL="mongodb://127.0.0.1:27017/academic_portfolio"

# Container path used by the app for local file storage.
LOCAL_STORAGE_ROOT="/app/storage"
# Host-local directory for uploaded files. Use an absolute path for production.
FILE_STORAGE_PATH="/srv/professor-portfolio/storage"

# Optional public origin used when generating sitemap URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js session secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Set this to true when the application is served behind a trusted reverse proxy.
# Auth.js trusts localhost automatically in development.
AUTH_TRUST_HOST=""

# Used only when creating the development seed administrator for the first time.
# Keep this value out of source control and unset it after seeding.
ADMIN_SEED_PASSWORD=""

# Required only for an explicit development seed invocation; never use YES in production.
SEED_DATABASE_CONFIRMATION=""

# One-time administrator bootstrap. The Compose bootstrap profile creates only
# the first SUPER_ADMIN, hashes the password, and never resets an existing
# account implicitly. Remove or unset these values after bootstrapping.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_CONFIRMATION=""
