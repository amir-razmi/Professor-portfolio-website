# Explicit environment label used to protect development-only database seeding.
DATABASE_ENV="development"

# Server-only MongoDB connection string used by Prisma.
DATABASE_URL="mongodb://127.0.0.1:27017/academic_portfolio_dev"

# Development-only local file storage root. Keep outside version control.
LOCAL_STORAGE_ROOT="./storage"

# Optional public origin used when generating sitemap URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js session secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Set this to true when the application is served behind a trusted reverse proxy.
# Auth.js trusts localhost automatically in development.
AUTH_TRUST_HOST=""

# Used only when creating the development seed administrator for the first time.
# Keep this value out of source control and unset it after seeding.
ADMIN_SEED_PASSWORD=""

# Required only for an explicit development seed invocation; never use YES in production.
SEED_DATABASE_CONFIRMATION=""
