{
  "name": "professor-portfolio-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/auth/*.test.ts tests/content/*.test.ts tests/public/*.test.ts tests/blog/*.test.ts tests/files/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:check": "tsx prisma/check-connection.ts",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.1",
    "bcryptjs": "3.0.3",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.7",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "17.4.2",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prisma": "6.19.1",
    "tailwindcss": "4.1.7",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
