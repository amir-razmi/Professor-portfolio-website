generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum AdminAccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  ENABLE
  DISABLE
  UPLOAD
  DELETE_FILE
  LOGIN
  LOGOUT
}

model AdminUser {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  email             String             @unique
  displayName       String
  passwordHash      String?
  role              AdminRole          @default(EDITOR)
  status            AdminAccountStatus @default(INVITED)
  isActive          Boolean            @default(false)
  lastLoginAt       DateTime?
  createdById       String?            @db.ObjectId
  updatedById       String?            @db.ObjectId
  authoredBlogPosts BlogPost[]         @relation("BlogPostAuthor")
  uploadedFiles     FileAsset[]        @relation("FileAssetUploader")
  auditLogs         AuditLog[]         @relation("AuditLogActor")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([role])
  @@index([status, isActive])
}

model ProfessorProfile {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  key                 String     @unique @default("default")
  fullName            String
  title               String?
  department          String?
  institution         String?
  shortBio            String?
  biography           String?
  education           String[]   @default([])
  academicPositions   String[]   @default([])
  researchInterests   String[]   @default([])
  teachingInterests   String[]   @default([])
  awards              String[]   @default([])
  experience          String[]   @default([])
  email               String?
  office              String?
  phone               String?
  websiteUrl          String?
  orcid               String?
  googleScholarUrl    String?
  researchGateUrl     String?
  linkedinUrl         String?
  githubUrl           String?
  profileImageUrl     String?
  profileImageAssetId String?    @db.ObjectId
  profileImage        FileAsset? @relation("ProfessorProfileImage", fields: [profileImageAssetId], references: [id])
  isPublished         Boolean    @default(false)
  createdById         String?    @db.ObjectId
  updatedById         String?    @db.ObjectId
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model SiteSettings {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  key               String     @unique @default("default")
  siteName          String
  siteDescription   String?
  contactEmail      String?
  defaultLocale     String     @default("en")
  timezone          String     @default("UTC")
  maintenanceMode   Boolean    @default(false)
  footerText        String?
  defaultOgImageUrl String?
  defaultOgImageId  String?    @db.ObjectId
  defaultOgImage    FileAsset? @relation("SiteSettingsOgImage", fields: [defaultOgImageId], references: [id])
  createdById       String?    @db.ObjectId
  updatedById       String?    @db.ObjectId
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model BlogPost {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String         @unique
  excerpt      String?
  content      String
  status       BlogPostStatus @default(DRAFT)
  publishedAt  DateTime?
  isFeatured   Boolean        @default(false)
  authorId     String         @db.ObjectId
  author       AdminUser      @relation("BlogPostAuthor", fields: [authorId], references: [id])
  categoryIds  String[]       @db.ObjectId
  categories   BlogCategory[] @relation("BlogPostCategories", fields: [categoryIds], references: [id])
  tagIds       String[]       @db.ObjectId
  tags         BlogTag[]      @relation("BlogPostTags", fields: [tagIds], references: [id])
  coverAssetId String?        @db.ObjectId
  coverAsset   FileAsset?     @relation("BlogPostCoverAsset", fields: [coverAssetId], references: [id])
  createdById  String?        @db.ObjectId
  updatedById  String?        @db.ObjectId
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([isFeatured, status])
}

model BlogCategory {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String     @unique
  slug        String     @unique
  description String?
  isActive    Boolean    @default(true)
  postIds     String[]   @db.ObjectId
  posts       BlogPost[] @relation("BlogPostCategories", fields: [postIds], references: [id])
  createdById String?    @db.ObjectId
  updatedById String?    @db.ObjectId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
}

model BlogTag {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String     @unique
  slug        String     @unique
  isActive    Boolean    @default(true)
  postIds     String[]   @db.ObjectId
  posts       BlogPost[] @relation("BlogPostTags", fields: [postIds], references: [id])
  createdById String?    @db.ObjectId
  updatedById String?    @db.ObjectId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
}

model FileAsset {
  id                     String             @id @default(auto()) @map("_id") @db.ObjectId
  storageKey             String             @unique
  originalName           String
  mimeType               String
  sizeBytes              BigInt
  visibility             FileVisibility     @default(PRIVATE)
  bucket                 String?
  checksum               String?
  width                  Int?
  height                 Int?
  uploadedById           String             @db.ObjectId
  uploadedBy             AdminUser          @relation("FileAssetUploader", fields: [uploadedById], references: [id])
  blogPostCovers         BlogPost[]         @relation("BlogPostCoverAsset")
  professorProfileImages ProfessorProfile[] @relation("ProfessorProfileImage")
  siteSettingsOgImages   SiteSettings[]     @relation("SiteSettingsOgImage")
  createdById            String?            @db.ObjectId
  updatedById            String?            @db.ObjectId
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([visibility, createdAt])
  @@index([mimeType])
  @@index([uploadedById])
}

model ResearchItem {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String        @unique
  summary      String?
  description  String?
  externalUrl  String?
  startDate    DateTime?
  endDate      DateTime?
  isPublished  Boolean       @default(false)
  publishedAt  DateTime?
  publications Publication[]
  createdById  String?       @db.ObjectId
  updatedById  String?       @db.ObjectId
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([isPublished, publishedAt])
  @@index([startDate])
}

model Publication {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String        @unique
  citation        String?
  abstract        String?
  authors         String[]
  venue           String?
  doi             String?
  url             String?
  publicationDate DateTime?
  isPublished     Boolean       @default(false)
  publishedAt     DateTime?
  isFeatured      Boolean       @default(false)
  researchItemId  String?       @db.ObjectId
  researchItem    ResearchItem? @relation(fields: [researchItemId], references: [id])
  createdById     String?       @db.ObjectId
  updatedById     String?       @db.ObjectId
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([isPublished, publicationDate])
  @@index([researchItemId])
}

model AuditLog {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  action         AuditAction
  targetResource String
  targetId       String?
  summary        String?
  actorId        String?     @db.ObjectId
  actor          AdminUser?  @relation("AuditLogActor", fields: [actorId], references: [id])
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime    @default(now())

  @@index([targetResource])
  @@index([targetId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
